# Copy this file to  deploy\secrets.local.ps1  (git-ignored) and fill in the
# real values. deploy.ps1 sources it automatically on the next run.
#
# Keep the copy OUT of git: it holds live credentials.

$env:TELEGRAM_BOT_TOKEN = 'PUT-TELEGRAM-BOT-TOKEN-HERE'
$env:SLACK_WEBHOOK_URL  = 'https://hooks.slack.com/services/XXX/YYY/ZZZ'

# Optional: pick the Grafana admin password yourself. Without it deploy.ps1 generates a
# random one on the first deploy, prints it once, and reuses the stored value afterwards.
# $env:GRAFANA_ADMIN_PASSWORD = 'change-me'
