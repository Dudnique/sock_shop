# ARCHIVED - this was deploy/kubernetes/Makefile; see ci-legacy/README.md.
# Kept with its Dockerfile (manifests-Dockerfile) for reference only: the two
# commands it wraps are a one-liner each and are run directly now:
#   awk '{print}' deploy/kubernetes/manifests/* > deploy/kubernetes/complete-demo.yaml
#   awk '{print}' deploy/kubernetes/manifests/* | diff deploy/kubernetes/complete-demo.yaml -
# (the second one is exactly what CI runs, see .github/workflows/main.yaml).

PWD = $(shell pwd)
MANIFESTS = $(or $(shell printenv MANIFESTS), manifests)

.PHONY: gen-complete-demo
gen-complete-demo:
	awk '{print}' ${MANIFESTS}/* > complete-demo.yaml
.PHONY: check-complete-demo
check-complete-demo:
	awk '{print}' ${MANIFESTS}/* | diff complete-demo.yaml -
.dockerimage: Dockerfile
	docker build -t manifests-image .
	touch .dockerimage

.PHONY: docker-%
docker-%: .dockerimage
	docker \
	  run \
	  --rm \
	  -it \
	  -u ${UID}:${GID} \
	  -v ${PWD}:/workdir \
	  manifests-image \
	  make $*
